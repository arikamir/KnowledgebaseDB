+            return;
+        }
+
+        ObjectNode identity = mapper.createObjectNode();
+        identity.put("type", systemAssigned
+                ? (userAssigned.isEmpty() ? "SystemAssigned" : "SystemAssigned, UserAssigned")
+                : "UserAssigned");
+        if (!userAssigned.isEmpty()) {
+            ObjectNode identities = mapper.createObjectNode();
+            userAssigned.forEach(resourceId -> identities.set(resourceId, mapper.createObjectNode()));
+            identity.set("userAssignedIdentities", identities);
+        }
+        ((ObjectNode) tmp.get("resources").get(0)).set("identity", identity);
+    }
