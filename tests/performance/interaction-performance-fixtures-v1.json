    "uuidNameTemplate": "interaction-performance-profile-v1:{scenario}:{phase}:{workerIndex}:{requestOrdinal}:{field}",
    "tokenAlgorithm": "lowercase hexadecimal SHA-256 of the same name template, prefixed with sc050-{field}- and truncated to 64 total characters",
    "placeholderGrammar": {
      "${constant:name}": "Replace with the exact constants[name] native JSON value; when embedded in a larger string the value MUST be a string.",
      "${uuidv5:field}": "Replace with UUIDv5(uuidNamespace, uuidNameTemplate with field substituted).",
      "${token:field}": "Replace with the tokenAlgorithm result for field.",
      "${time:field}": "Replace with the timestampRule result for issuedAt, idleExpiresAt, or absoluteExpiresAt.",
      "${template:path}": "Deep-copy the exact already-defined JSON value at path before applying this scenario's derived placeholders."
    },
    "resolutionOrder": "Reject cycles; resolve template and constant references first, then UUIDv5, token, and time placeholders; reject every unknown or unresolved placeholder before state setup or request validation.",
    "fixtureInheritanceRule": "seedStateRef deep-copies the named fixture's seedState after placeholder resolution; seedOverrides then replaces only the exact dotted/indexed path shown and rejects an absent or multiply matched path.",
    "phaseValues": [
      "warmup",
      "measured"
    ],
    "workerIndexRange": [
      0,
      9
    ],
    "warmupRequestOrdinalRange": [
      0,
      1
    ],
    "measuredRequestOrdinalRange": [
      0,
      9
    ],
    "clockEpoch": "2026-07-16T09:00:00Z",
    "timestampRule": "issuedAt equals clockEpoch plus workerIndex minutes plus requestOrdinal seconds; idleExpiresAt is issuedAt plus 30 minutes; absoluteExpiresAt is issuedAt plus 8 hours."
