{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://career-agent.internal/schemas/lab-provider-policy-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "policyVersion", "groups", "providers"],
  "properties": {
    "schemaVersion": {"const": 1},
    "policyVersion": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"},
    "groups": {
      "type": "object",
      "additionalProperties": false,
      "required": ["learningContentOwnersObjectId", "applicationSecurityReviewersObjectId"],
      "properties": {
        "learningContentOwnersObjectId": {"$ref": "#/$defs/objectId"},
        "applicationSecurityReviewersObjectId": {"$ref": "#/$defs/objectId"}
      }
    },
    "providers": {
      "type": "array",
      "items": {"$ref": "#/$defs/provider"}
    }
  },
  "$defs": {
    "objectId": {
      "type": "string",
      "anyOf": [
        {"pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"},
        {"pattern": "^\\$\\{[A-Z][A-Z0-9_]+\\}$"}
      ]
    },
    "membershipEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "verifiedAt", "auditReference"],
      "properties": {
        "source": {"const": "microsoft-entra-group-membership"},
        "verifiedAt": {"type": "string", "format": "date-time"},
        "auditReference": {"type": "string", "minLength": 8, "maxLength": 256}
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approverObjectId", "memberOfGroupObjectId", "membershipEvidence"],
      "properties": {
        "approverObjectId": {"$ref": "#/$defs/objectId"},
        "memberOfGroupObjectId": {"$ref": "#/$defs/objectId"},
        "membershipEvidence": {"$ref": "#/$defs/membershipEvidence"}
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["providerId", "displayName", "domains", "reason", "effectiveAt", "policyVersion", "auditReference", "approvals"],
      "properties": {
        "providerId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
        "displayName": {"type": "string", "minLength": 2, "maxLength": 128},
        "domains": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "format": "hostname"}},
        "reason": {"type": "string", "minLength": 20, "maxLength": 500},
        "effectiveAt": {"type": "string", "format": "date-time"},
        "policyVersion": {"type": "string", "minLength": 3, "maxLength": 64},
        "auditReference": {"type": "string", "minLength": 8, "maxLength": 256},
        "approvals": {
          "type": "object",
          "additionalProperties": false,
          "required": ["learningContentOwner", "applicationSecurityReviewer"],
          "properties": {
            "learningContentOwner": {"$ref": "#/$defs/approval"},
            "applicationSecurityReviewer": {"$ref": "#/$defs/approval"}
          }
        }
      }
    }
  }
}
