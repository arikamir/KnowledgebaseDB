{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "catalog_version", "topics"],
  "properties": {
    "schema_version": { "const": 1 },
    "catalog_version": { "type": "string", "pattern": "^1\\.[0-9]+\\.[0-9]+$" },
    "topics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "category", "aliases", "status"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "category": { "type": "string", "minLength": 1 },
          "aliases": { "type": "array", "items": { "type": "string" } },
          "status": { "enum": ["active", "unavailable", "retired"] }
        },
        "additionalProperties": false
      }
    }
  }
}
