approved_machine_consumers = {
  existing-machine-client = {
    display_name = "Existing Career Agent machine client"
    roles = [
      "CareerAgent.Roadmap.Generate",
      "CareerAgent.Guidance.Read",
      "CareerAgent.Progress.Write",
    ]
  }
}
